; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project_Heartache"
config/version="0.1.5"
run/main_scene="uid://bk6rwqeytisu1"
config/features=PackedStringArray("4.6", "Forward Plus")
run/max_fps=144
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://ddud0m5r4yr7q"
driver/driver=""

[autoload]

GameManager="*uid://bua52v6hey7sp"
InputManager="*res://Scripts/Autoloads/input_manager.gd"
Console="*res://Scripts/Autoloads/console.tscn"
SaverLoader="*uid://ykafa18d674h"
Game="*uid://c6lsg8mdiygf"
AudioManager="*res://Scripts/Autoloads/audio_manager.gd"
DialogueManager="*uid://conva0l7uc3pg"

[debug]

settings/physics_interpolation/enable_warnings=false

[display]

window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/converter/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "orange",
"res://Entities/": "red",
"res://Resources/": "green",
"res://Scenes/": "pink",
"res://Scripts/": "purple"
}

[global_group]

PlayerCharacter=""
Save=""
DynamicLights=""
StaticLights=""
GlobalIllumination=""
Menu=""

[importer_defaults]

scene={
&"gltf/embedded_image_handling": 3,
&"meshes/light_baking": 2
}
wavefront_obj={
&"generate_lightmap_uv2": true
}
texture={
&"detect_3d/compress_to": 0,
&"mipmaps/generate": true
}

