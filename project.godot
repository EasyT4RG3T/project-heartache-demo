[layer_names]

3d_render/layer_1="Main"
3d_render/layer_2="Inventory"
3d_render/layer_3="Dynamic"
3d_physics/layer_1="World"
3d_physics/layer_2="Dynamic"
3d_physics/layer_3="DynamicNoCol"
3d_physics/layer_4="Player"
3d_physics/layer_5="OnScreen"
3d_physics/layer_6="PickedUp"
3d_physics/layer_7="Wettable"
3d_physics/layer_8="NoPlayer"

[physics]

common/physics_jitter_fix=0.0
3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[raytraced_audio]

reverb_bus=&"RaytracedReverb"
ambient_bus=&"RaytracedAmbient"

[rendering]

occlusion_culling/bvh_build_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0
global_illumination/gi/use_half_resolution=true
global_illumination/voxel_gi/quality=1
textures/default_filters/use_nearest_mipmap_filter=true
textures/default_filters/anisotropic_filtering_level=0
environment/ssao/half_size=false
environment/ssao/blur_passes=0
anti_aliasing/screen_space_roughness_limiter/enabled=false
textures/decals/filter=2
occlusion_culling/use_occlusion_culling=true
lights_and_shadows/positional_shadow/atlas_size=16384
lights_and_shadows/positional_shadow/atlas_quadrant_2_subdiv=2
lights_and_shadows/positional_shadow/atlas_quadrant_3_subdiv=2
environment/defaults/default_environment="uid://b5hbq6dr1gixx"
