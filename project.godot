; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Project_Heartache"
config/version="0.0.1"
run/main_scene="uid://evmnqmy0k477"
config/features=PackedStringArray("4.6", "Forward Plus")
run/max_fps=144
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://ddud0m5r4yr7q"

[autoload]

GameManager="*res://Scripts/Autoloads/game_manager.gd"
InputManager="*res://Scripts/Autoloads/input_manager.gd"
Console="*res://Scripts/Autoloads/console.tscn"
SaverLoader="*res://Scripts/Autoloads/saverloader.gd"
Game="*res://Scripts/Autoloads/game.gd"
AudioManager="*res://Scripts/Autoloads/audio_manager.gd"

[display]

window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/raytraced_audio/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "orange",
"res://Entities/": "red",
"res://Resources/": "green",
"res://Scenes/": "pink",
"res://Scripts/": "purple"
}

[global_group]

PlayerCharacter=""
Save=""
DynamicLights=""
StaticLights=""
GlobalIllumination=""

[importer_defaults]

scene={
&"gltf/embedded_image_handling": 3,
&"meshes/light_baking": 2
}
wavefront_obj={
&"generate_lightmap_uv2": true
}

